# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/car_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=your_password_here

# Admin Credentials
ADMIN_USER=admin
